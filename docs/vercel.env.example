# SAMPLE ONLY. Never put real secrets in this file or commit a real .env.
# Vercel Project Root Directory: repository root. Node.js: 22.x. Owner chose Hobby.
# Set variables in Vercel's secure dashboard with the correct environment scope.
# Owner-confirmed domain; this sample does not configure or publish it.
# No Vercel cron: a separate free Cloudflare scheduler must be configured.
# Vercel restricts Hobby to personal/non-commercial use; technical compatibility
# does not make this commercial site compliant with that restriction.
SITE_URL=https://golfsimsorel.ca
RUNTIME_STORAGE=postgres
# The existing site stays on Neon until owner-approved cutover.
# Adding SUPABASE_DATABASE_URL alone never changes the active database.
DATABASE_PROVIDER=neon

# Production secrets: enter values directly in Vercel, never in chat or Git.
NEON_DATABASE_URL=
# Supabase: provider-issued shared Transaction pooler (6543), TLS required.
SUPABASE_DATABASE_URL=
# Public reference of the future production Supabase project; set in ALL scopes.
# Required for preview isolation when the production URL is production-scoped.
SUPABASE_PRODUCTION_PROJECT_REF=
SESSION_SECRET=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_WEBHOOK_SECRET=
RESEND_API_KEY=

# Keep disabled until external verification / owner-approved cutover.
CALENDAR_ENABLED=false
CONTACT_EMAIL_ENABLED=false
# Proposed sender only: verify notifications.golfsimsorel.ca with Resend first.
CONTACT_EMAIL_FROM=contact@notifications.golfsimsorel.ca
CONTACT_EMAIL_TO=golfsim.soreltracy@gmail.com

# PREVIEW scope only. Never point this URL at the live branch.
PREVIEW_DATABASE_URL=
PREVIEW_CALENDAR_ENABLED=false
PREVIEW_CALENDAR_ID=
PREVIEW_GOOGLE_CLIENT_ID=
PREVIEW_GOOGLE_CLIENT_SECRET=
PREVIEW_GOOGLE_REDIRECT_URI=
PREVIEW_CONTACT_EMAIL_TO=
